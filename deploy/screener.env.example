# Server settings for the mock demo. install.sh copies this file to
# /etc/company-screener/screener.env (root only, mode 600) once, and fills in a random
# DEMO_ACCESS_TOKEN. Never put an API key here while the demo is in mock mode.

# Mock mode only: no Claude Code and no API on the server.
LLM_BACKEND=mock

# Access: every page and the API need the token (PUBLIC_DEMO makes it mandatory).
PUBLIC_DEMO=true
DEMO_ACCESS_TOKEN=
COOKIE_SECURE=true

# Ready-made synthetic examples on saved pages (/examples).
DEMO_EXAMPLES=true

# Job size: URLs per screening, page size, page text kept per page.
MAX_URLS_PER_REQUEST=10
FETCH_MAX_BYTES=1000000
PAGE_TEXT_MAX_CHARS=15000

# Parallelism: one screening at a time, two companies of it at once. A screening that
# takes longer than RUN_TIMEOUT_S seconds is stopped and its slot freed.
MAX_ACTIVE_RUNS=1
CONCURRENCY=2
RUN_TIMEOUT_S=300

# Results are kept in memory only: at most 20 runs, each for at most 1 hour.
MAX_STORED_RUNS=20
RUN_TTL_S=3600

# Abuse limits (in memory, reset on restart).
RUNS_PER_IP_PER_HOUR=6
LOGIN_ATTEMPTS_PER_IP_PER_15_MIN=10
DAILY_MAX_COMPANIES=200
