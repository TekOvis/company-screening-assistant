# Copy to .env for local overrides. Never commit .env (it is in .gitignore).
# Every value is optional; the defaults are shown.

# "mock" = deterministic keyword rules, no API key, no paid calls (default).
# "anthropic" = real Claude API calls, which cost money.
LLM_BACKEND=mock

# Needed only when LLM_BACKEND=anthropic. Keep it in your environment or .env, never in Git.
ANTHROPIC_API_KEY=

# Model and request settings (used only by the anthropic backend)
LLM_MODEL=claude-sonnet-5-5
LLM_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=8000
VERIFIER_MAX_OUTPUT_TOKENS=4000
LLM_REQUEST_TIMEOUT_S=120
# Retries of temporary API errors (each attempt counts against the budgets below)
LLM_MAX_RETRIES=2

# Agent limits per company
MAX_TOOL_CALLS=3
MAX_LLM_CALLS=4
# Claims sent to the evidence verifier in its single request per company
MAX_CLAIMS_TO_VERIFY=25

# Budgets: every API attempt counts (agent turns, evidence check, retries)
MAX_LLM_REQUESTS_PER_COMPANY=8
MAX_TOKENS_PER_COMPANY=80000
MAX_LLM_REQUESTS_PER_RUN=60
MAX_TOKENS_PER_RUN=600000

# Request limits
MAX_URLS_PER_REQUEST=10
CONCURRENCY=3

# In-memory job store (no database): stored runs, lifetime of finished runs, runs at once
MAX_STORED_RUNS=50
RUN_TTL_S=7200
MAX_ACTIVE_RUNS=2

# Page fetching limits
FETCH_CONNECT_TIMEOUT_S=5
FETCH_READ_TIMEOUT_S=10
FETCH_TOTAL_TIMEOUT_S=25
FETCH_MAX_RETRIES=2
FETCH_MAX_BYTES=2000000
FETCH_MAX_REDIRECTS=4
PAGE_TEXT_MAX_CHARS=15000
MAX_LINKS_PER_PAGE=40
